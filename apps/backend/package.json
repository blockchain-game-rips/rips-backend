{
	"name": "backend",
	"version": "0.0.1",
	"description": "",
	"author": "",
	"private": true,
	"license": "UNLICENSED",
	"scripts": {
		"generate": "prisma generate && prisma generate --config prisma.indexer.config.ts",
		"build": "yarn generate && nest build",
		"test": "vitest run",
		"test:unit": "vitest run --project unit",
		"test:integration": "vitest run --project integration",
		"test:e2e": "vitest run --project e2e",
		"fmt": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
		"lint": "eslint src test",
		"lint:fix": "eslint src test --fix",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"start": "node dist/src/main.js",
		"dev": "nest start --watch",
		"executor:ensure": "ts-node -r tsconfig-paths/register scripts/ensure-executors.ts",
		"cards:seed": "ts-node -r tsconfig-paths/register scripts/seed-card-definitions.ts",
		"registry:enrich": "ts-node -r tsconfig-paths/register scripts/enrich-currency-registry.ts",
		"admin:ensure": "ts-node scripts/ensure-admin-wallet.ts",
		"eligibility:setup": "ts-node -r tsconfig-paths/register scripts/setup-eligibility-policy.ts",
		"gen-config-schema": "ts-node -r tsconfig-paths/register utils/generate-configuration-schema.ts",
		"gen-openapi": "ts-node -r tsconfig-paths/register scripts/generate-openapi.ts"
	},
	"dependencies": {
		"@aws-sdk/client-kms": "^3.1010.0",
		"@google-cloud/kms": "^5.4.0",
		"@nestjs/cache-manager": "^3.1.0",
		"@nestjs/common": "^11.0.1",
		"@nestjs/config": "^4.0.3",
		"@nestjs/core": "^11.0.1",
		"@nestjs/platform-express": "^11.0.1",
		"@nestjs/schedule": "6.0.0",
		"@nestjs/swagger": "^11.3.2",
		"@prisma/adapter-pg": "^7.5.0",
		"@prisma/client": "^7.5.0",
		"@rips/abi": "workspace:*",
		"@rips/test-harness": "workspace:*",
		"@willsoto/nestjs-prometheus": "^6.1.0",
		"axios": "^1.13.6",
		"cache-manager": "^7.2.8",
		"get-port": "5",
		"js-yaml": "4.1.0",
		"ky": "1.7.5",
		"nestjs-pino": "^4.6.1",
		"nestjs-zod": "^5.3.0",
		"pg": "^8.20.0",
		"pino": "^10.3.1",
		"pino-http": "^11.0.0",
		"prom-client": "^15.1.3",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.1",
		"viem": "^2.47.4",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3.2.0",
		"@eslint/js": "^9.18.0",
		"@nestjs/cli": "^11.0.0",
		"@nestjs/schematics": "^11.0.0",
		"@nestjs/testing": "^11.0.1",
		"@swc/cli": "^0.6.0",
		"@swc/core": "^1.10.7",
		"@testcontainers/postgresql": "^11.13.0",
		"@types/express": "^5.0.0",
		"@types/js-yaml": "4.0.9",
		"@types/node": "^22.10.7",
		"@types/pg": "^8.18.0",
		"@types/supertest": "^6.0.2",
		"eslint": "^9.18.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-prettier": "^5.2.2",
		"eslint-plugin-unused-imports": "^4.4.1",
		"globals": "^16.0.0",
		"nock": "^14.0.17",
		"pino-pretty": "^13.1.3",
		"prettier": "^3.4.2",
		"prettier-plugin-organize-imports": "^4.3.0",
		"prisma": "^7.5.0",
		"source-map-support": "^0.5.21",
		"supertest": "^7.0.0",
		"testcontainers": "^11.13.0",
		"ts-loader": "^9.5.2",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0",
		"typescript": "^5.7.3",
		"typescript-eslint": "^8.20.0",
		"vitest": "^4.1.10"
	}
}
