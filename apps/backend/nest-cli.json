{
    "$schema": "https://json.schemastore.org/nest-cli",
    "collection": "@nestjs/schematics",
    "sourceRoot": "src",
    "compilerOptions": {
        "deleteOutDir": true,
        "assets": [
            { "include": "../generated/prisma/**/*", "outDir": "./dist/generated" },
            { "include": "../generated/prisma-indexer/**/*", "outDir": "./dist/generated" },
            {
                "include": "infrastructure/token-registry/enriched-registry.json",
                "outDir": "./dist/src"
            }
        ]
    }
}
