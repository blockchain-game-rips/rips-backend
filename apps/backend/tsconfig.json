{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "removeComments": true,
        "outDir": "./dist",
        "incremental": true,
        "strictNullChecks": true,
        "noImplicitAny": false,
        "strictBindCallApply": false,
        "noFallthroughCasesInSwitch": false,
        "types": ["node", "vitest/globals"]
    },
    "exclude": ["dist", "vitest.config.mts"]
}
