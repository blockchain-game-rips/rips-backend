generator client {
  provider = "prisma-client-js"
  output   = "../../generated/prisma-indexer"
}

datasource db {
  provider = "postgresql"
}

model callback_gas_limit_updated {
  id                 String   @id(map: "PK_a305b055fb37aedee5484f5c2d7") @db.VarChar
  callback_gas_limit Int
  block_number       Decimal  @db.Decimal
  time               DateTime @db.Timestamptz(6)
  tx_hash            String
}

model config {
  id               String        @id(map: "PK_d0ee79a681413d50b0a4f98cf7b") @db.VarChar
  entry_cap        Decimal       @db.Decimal
  currency         String
  duration_seconds Decimal       @db.Decimal
  entry_price      Decimal       @db.Decimal
  fee_bps          Decimal       @db.Decimal
  preset_id        String?       @db.VarChar
  preset           preset?       @relation(fields: [preset_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_fdef900a0897e034d4915860209")
  payout_tier      payout_tier[]
  rip              rip[]

  @@index([preset_id], map: "IDX_fdef900a0897e034d491586020")
}

model default_referral_fee_updated {
  id                       String   @id(map: "PK_5ffc9a5b3b9e0722c5c182ac277") @db.VarChar
