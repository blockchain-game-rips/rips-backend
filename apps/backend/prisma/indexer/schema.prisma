  time         DateTime @db.Timestamptz(6)
  tx_hash      String
  rip_id       String?  @db.VarChar
  rip          rip?     @relation(fields: [rip_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_f54f79f651c54024ce8f68d806a")

  @@index([rip_id], map: "IDX_f54f79f651c54024ce8f68d806")
