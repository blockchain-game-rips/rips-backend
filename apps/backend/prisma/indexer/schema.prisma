}

model entry_purchase {
  id                String   @id(map: "PK_a077a422e4106f9aacfcd817c34") @db.VarChar
  user              String
  entry_count       Decimal  @db.Decimal
  start_entry_index Decimal  @db.Decimal
  block_number      Decimal  @db.Decimal
  time              DateTime @db.Timestamptz(6)
  tx_hash           String
  rip_id            String?  @db.VarChar
  rip               rip?     @relation(fields: [rip_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_7ea7e6ba0b75e4d49ed06f7f4cc")

  @@index([rip_id], map: "IDX_7ea7e6ba0b75e4d49ed06f7f4c")
}

