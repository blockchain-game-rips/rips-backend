generator client {
    provider = "prisma-client-js"
    output   = "../generated/prisma"
}

datasource db {
    provider = "postgresql"
}

model User {
    id              BigInt     @id @default(autoincrement())
    telegramId      BigInt     @unique @map("telegram_id")
    referrerAddress String?    @map("referrer_address")
    createdAt       DateTime   @default(now()) @map("created_at")
    evmWallet       EvmWallet?

    @@map("users")
}

model EvmWallet {
    id                  BigInt   @id @default(autoincrement())
    address             String   @unique
    encryptedPrivateKey Bytes    @map("encrypted_private_key")
    kekVersion          String   @map("kek_version")
    createdAt           DateTime @default(now()) @map("created_at")
    userId              BigInt   @unique @map("user_id")
    user                User     @relation(fields: [userId], references: [id])

    @@map("evm_wallets")
}

model Executor {
    id             BigInt          @id @default(autoincrement())
    createdAt      DateTime        @default(now()) @map("created_at")
    executorWallet ExecutorWallet?

    @@map("executors")
}

model ExecutorWallet {
    id                  BigInt   @id @default(autoincrement())
    address             String   @unique
    encryptedPrivateKey Bytes    @map("encrypted_private_key")
    kekVersion          String   @map("kek_version")
    createdAt           DateTime @default(now()) @map("created_at")
    executorId          BigInt   @unique @map("executor_id")
    executor            Executor @relation(fields: [executorId], references: [id])

    @@map("executor_wallets")
}

model CardDefinition {
    id           BigInt        @id
    tier         Int
    name         String
    imageUrl     String        @map("image_url")
    createdAt    DateTime      @default(now()) @map("created_at")
    entryPayouts EntryPayout[]

    @@unique([tier, name])
    @@map("card_definitions")
}

enum NotificationType {
    CLAIMED
    REFUNDED
}

// userId = 0 represents a group broadcast (no specific user)
model Notification {
    id         BigInt           @id @default(autoincrement())
    userId     BigInt           @map("user_id")
    ripId    Int              @map("rip_id")
    type       NotificationType
    createdAt  DateTime         @default(now()) @map("created_at")
    isNotified Boolean          @default(false) @map("is_notified")

    @@unique([userId, ripId, type])
    @@map("notifications")
}

model SyncedRip {
    ripId  Int      @id @map("rip_id")
    syncedAt DateTime @default(now()) @map("synced_at")

    settleBlockNumber  BigInt? @map("settle_block_number")
    settleLogIndex     Int?    @map("settle_log_index")
    drawRulesFingerprint String? @map("draw_rules_fingerprint")

    payouts EntryPayout[]

    @@index([syncedAt(sort: Desc), ripId(sort: Desc)], map: "synced_rips_synced_at_rip_id_desc_idx")
    @@index([settleBlockNumber, settleLogIndex])
    @@map("synced_rips")
}

model AdminWallet {
    id                  BigInt   @id @default(autoincrement())
    singleton           String   @unique @default("admin")
    address             String   @unique
    encryptedPrivateKey Bytes    @map("encrypted_private_key")
    kekVersion          String   @map("kek_version")
    createdAt           DateTime @default(now()) @map("created_at")

    @@map("admin_wallets")
}

model EntryPayout {
    id               BigInt         @id @default(autoincrement())
    userAddress      String         @map("user_address")
    ripId          Int            @map("rip_id")
    entryNumber     Int            @map("entry_number")
    payoutAmount      BigInt         @map("payout_amount")
    cardDefinitionId BigInt         @map("card_definition_id")
    revealed         Boolean        @default(false)
    createdAt        DateTime       @default(now()) @map("created_at")
    cardDefinition   CardDefinition @relation(fields: [cardDefinitionId], references: [id])
    rip              SyncedRip      @relation(fields: [ripId], references: [ripId], onDelete: Cascade)

    @@unique([ripId, entryNumber])
    @@index([userAddress, revealed])
    @@map("entry_payouts")
}
