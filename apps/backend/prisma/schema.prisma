generator client {
    provider = "prisma-client-js"
    output   = "../generated/prisma"
}

datasource db {
    provider = "postgresql"
}

model User {
    id              BigInt     @id @default(autoincrement())
    telegramId      BigInt     @unique @map("telegram_id")
    referrerAddress String?    @map("referrer_address")
    createdAt       DateTime   @default(now()) @map("created_at")
    evmWallet       EvmWallet?

    @@map("users")
}

model EvmWallet {
    id        BigInt   @id @default(autoincrement())
    address   String   @unique
    kmsKeyId  String   @map("kms_key_id")
    createdAt DateTime @default(now()) @map("created_at")
    userId    BigInt   @unique @map("user_id")
    user      User     @relation(fields: [userId], references: [id])

    @@map("evm_wallets")
}

model Executor {
    id             BigInt          @id @default(autoincrement())
    createdAt      DateTime        @default(now()) @map("created_at")
    executorWallet ExecutorWallet?

    @@map("executors")
}

model ExecutorWallet {
    id         BigInt   @id @default(autoincrement())
    address    String   @unique
    kmsKeyId   String   @map("kms_key_id")
    createdAt  DateTime @default(now()) @map("created_at")
    executorId BigInt   @unique @map("executor_id")
    executor   Executor @relation(fields: [executorId], references: [id])

    @@map("executor_wallets")
}

model CardDefinition {
    id           BigInt        @id @default(autoincrement())
    stakeId      Int           @map("stake_id")
    tier         Int
    name         String
    imageUrl     String        @map("image_url")
    createdAt    DateTime      @default(now()) @map("created_at")
    userCards    UserCard[]
    ticketPrizes TicketPrize[]

    @@unique([stakeId, tier, name])
    @@map("card_definitions")
}

model UserCard {
    id               BigInt         @id @default(autoincrement())
    userAddress      String         @map("user_address")
    cardDefinitionId BigInt         @map("card_definition_id")
    quantity         Int            @default(1)
    firstObtainedAt  DateTime       @default(now()) @map("first_obtained_at")
    cardDefinition   CardDefinition @relation(fields: [cardDefinitionId], references: [id])

    @@unique([userAddress, cardDefinitionId])
    @@map("user_cards")
}

enum NotificationType {
    CLAIMED
    REFUNDED
}

// userId = 0 represents a group broadcast (no specific user)
model Notification {
    id         BigInt           @id @default(autoincrement())
    userId     BigInt           @map("user_id")
    roundId    Int              @map("round_id")
    type       NotificationType
    createdAt  DateTime         @default(now()) @map("created_at")
    isNotified Boolean          @default(false) @map("is_notified")

    @@unique([userId, roundId, type])
    @@map("notifications")
}

model SyncedRound {
    roundId  Int      @id @map("round_id")
    syncedAt DateTime @default(now()) @map("synced_at")

    @@map("synced_rounds")
}

model AdminWallet {
    id        BigInt   @id @default(autoincrement())
    singleton String   @unique @default("admin")
    address   String   @unique
    kmsKeyId  String   @map("kms_key_id")
    createdAt DateTime @default(now()) @map("created_at")

    @@map("admin_wallets")
}

model TicketPrize {
    id               BigInt         @id @default(autoincrement())
    userAddress      String         @map("user_address")
    roundId          Int            @map("round_id")
    ticketNumber     Int            @map("ticket_number")
    prizeAmount      BigInt         @map("prize_amount")
    cardDefinitionId BigInt         @map("card_definition_id")
    revealed         Boolean        @default(false)
    createdAt        DateTime       @default(now()) @map("created_at")
    cardDefinition   CardDefinition @relation(fields: [cardDefinitionId], references: [id])

    @@unique([roundId, ticketNumber])
    @@map("ticket_prizes")
}
