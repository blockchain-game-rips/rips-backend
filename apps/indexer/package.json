{
	"name": "indexer",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"test": "yarn build && jest",
		"format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
		"build": "rm -rf lib && tsc -p tsconfig.build.json",
		"lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
		"generate-schema": "ts-node src/generate-schema.ts",
		"generate": "squid-typeorm-codegen && squid-evm-typegen ./src/abi ../../packages/abi/src/rips.json --multicall",
		"migration:generate:local": "ts-node test/utils/generate-migrations.ts"
	},
	"dependencies": {
		"@rips/abi": "workspace:*",
		"@rips/test-harness": "workspace:*",
		"@subsquid/evm-processor": "^1.18.0",
		"@subsquid/evm-typegen": "^4.0.0",
		"@subsquid/graphql-server": "^4.5.1",
		"@subsquid/typeorm-migration": "^1.3.0",
		"@subsquid/typeorm-store": "^1.4.0",
		"dotenv": "^16.4.5",
		"ethers": "^6.11.1",
		"graphql": "^15.8.0",
		"pg": "^8.11.5",
		"typeorm": "^0.3.20"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3.2.0",
		"@eslint/js": "^9.18.0",
		"@subsquid/evm-typegen": "^4.0.0",
		"@subsquid/typeorm-codegen": "^2.0.0",
		"@testcontainers/postgresql": "^11.13.0",
		"@types/jest": "^29.5.14",
		"@types/node": "^20.12.7",
		"eslint": "^9.18.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-prettier": "^5.2.2",
		"eslint-plugin-unused-imports": "^4.4.1",
		"get-port": "5",
		"jest": "^29.7.0",
		"prettier": "^3.4.2",
		"prettier-plugin-organize-imports": "^4.3.0",
		"ts-jest": "^29.2.5",
		"typescript": "^5.4.5",
		"typescript-eslint": "^8.20.0",
		"viem": "^2.47.5"
	}
}
