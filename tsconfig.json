{
    "compilerOptions": {
        "module": "commonjs",
        "target": "es2023",
        "outDir": "lib",
        "strict": true,
        "resolveJsonModule": true,
        "declaration": false,
        "sourceMap": true,
        "esModuleInterop": true,
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "skipLibCheck": true,
        "baseUrl": "./",
        "rootDir": "src"
    },
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "node_modules"
    ]
}
