{
    "compilerOptions": {
        "module": "commonjs",
        "target": "es2020",
        "outDir": "lib",
        "strict": true,
        "resolveJsonModule": true,
        "declaration": false,
        "sourceMap": true,
        "esModuleInterop": true,
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "skipLibCheck": true,
        "baseUrl": "./"
    },
    "include": [
        "src/**/*",
        "test/**/*"
    ],
    "exclude": [
        "node_modules"
    ]
}
