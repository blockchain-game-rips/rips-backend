{
	"name": "rips-monorepo",
	"version": "0.0.0",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"prepare": "lefthook install",
		"build": "yarn workspaces foreach -Aptv run build",
		"test": "yarn workspaces foreach -Apvi run test",
		"fmt": "yarn workspaces foreach -Apv run fmt",
		"lint": "yarn workspaces foreach -Apv run lint",
		"lint:fix": "yarn workspaces foreach -Apv run lint:fix",
		"typecheck": "yarn workspaces foreach -Apv run typecheck",
		"backend": "yarn workspace backend",
		"indexer": "yarn workspace indexer",
		"dev:up": "yarn workspace indexer build && NODE_ENV=development ts-node scripts/dev-up.ts",
		"dev:backend": "yarn workspace backend build && node --env-file=.env.backend.local apps/backend/dist/src/main.js",
		"dev:fill-random": "NODE_ENV=development ts-node scripts/dev-fill-random.ts",
		"sync-indexer-prisma-schema": "yarn workspace indexer build && ts-node scripts/sync-indexer-prisma-schema.ts"
	},
	"resolutions": {
		"ox": "0.14.5"
	},
	"packageManager": "yarn@4.17.0",
	"devDependencies": {
		"lefthook": "^2.1.9",
		"prettier": "^3.8.4",
		"prettier-plugin-organize-imports": "^4.3.0"
	}
}
